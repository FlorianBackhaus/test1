    {
      "parameters": {
        "jsCode": "const item = $input.first();\nconst prev = $('🔧 Daten vorbereiten').first().json;\n\nconst rawText = item.json.content?.[0]?.text || '';\nlet parsed;\ntry {\n  const clean = rawText.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch(e) {\n  throw new Error('JSON Parse Fehler: ' + rawText.substring(0, 200));\n}\n\nconst positionen = parsed.positionen || [];\nconst rows = positionen.map(pos => ({\n  json: {\n    email_id: prev.emailId || '',\n    email_datum: prev.emailDate || '',\n    pdf_dateiname: prev.filename,\n    dokumenttyp: parsed.dokumenttyp,\n    bestellnummer: parsed.bestellnummer,\n    bestelldatum: parsed.bestelldatum,\n    tagesdatum: parsed.tagesdatum,\n    kontrakt_nr: parsed.kontrakt_nr || '',\n    ansprechpartner: parsed.ansprechpartner,\n    ansprechpartner_tel: parsed.ansprechpartner_tel,\n    ansprechpartner_email: parsed.ansprechpartner_email,\n    lieferantennr: parsed.lieferantennr,\n    anlieferadresse_name: parsed.anlieferadresse_name || '',\n    anlieferadresse_strasse: parsed.anlieferadresse_strasse,\n    anlieferadresse_plz: parsed.anlieferadresse_plz,\n    anlieferadresse_ort: parsed.anlieferadresse_ort,\n    zahlungsbedingungen: parsed.zahlungsbedingungen,\n    gesamtnettowert: parsed.gesamtnettowert,\n    position_nr: pos.position_nr,\n    zeilen_nr: pos.zeilen_nr,\n    bezeichnung: pos.bezeichnung,\n    auftrag_nr: pos.auftrag_nr || '',\n    projekt: pos.projekt || '',\n    liefertermin: pos.liefertermin || '',\n    menge: pos.menge,\n    einheit: pos.einheit,\n    einzelpreis: pos.einzelpreis,\n    gesamtpreis: pos.gesamtpreis,\n    duplikat_key: parsed.bestellnummer + '_' + pos.position_nr\n  }\n}));\n\nreturn rows.length > 0 ? rows : [{ json: { skip: true } }];"
      },
