    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.first();\nconst binaryData = await this.helpers.getBinaryDataBuffer(item, 'attachment_0');\nconst base64 = binaryData.toString('base64');\n\nreturn [{\n  json: {\n    ...item.json,\n    pdfBase64: base64,\n    filename: item.binary?.attachment_0?.fileName || 'attachment.pdf'\n  }\n}];"
      },
      "id": "32727028-bfd8-4c4e-b662-24b575c8a382",
      "name": "🔧 Daten vorbereiten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 64]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-5\",\n  \"max_tokens\": 2000,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"document\",\n          \"source\": {\n            \"type\": \"base64\",\n            \"media_type\": \"application/pdf\",\n            \"data\": \"{{ $json.pdfBase64 }}\"\n          }\n        },\n        {\n          \"type\": \"text\",\n          \"text\": \"Lies dieses PDF (RheinNetz Bestellung oder Bestelländerung) und extrahiere alle relevanten Daten.\\n\\nGib AUSSCHLIESSLICH ein JSON-Objekt zurück, kein Text davor oder danach, keine Markdown-Backticks.\\n\\nStruktur:\\n{\\n  \\\"dokumenttyp\\\": \\\"Bestellung\\\" oder \\\"Änderung zur Bestellung\\\",\\n  \\\"bestellnummer\\\": \\\"string\\\",\\n  \\\"bestelldatum\\\": \\\"DD.MM.YYYY\\\",\\n  \\\"tagesdatum\\\": \\\"DD.MM.YYYY\\\",\\n  \\\"kontrakt_nr\\\": \\\"string oder null\\\",\\n  \\\"ansprechpartner\\\": \\\"string\\\",\\n  \\\"ansprechpartner_tel\\\": \\\"string\\\",\\n  \\\"ansprechpartner_email\\\": \\\"string\\\",\\n  \\\"lieferantennr\\\": \\\"string\\\",\\n  \\\"anlieferadresse_name\\\": \\\"string oder null\\\",\\n  \\\"anlieferadresse_strasse\\\": \\\"string\\\",\\n  \\\"anlieferadresse_plz\\\": \\\"string\\\",\\n  \\\"anlieferadresse_ort\\\": \\\"string\\\",\\n  \\\"zahlungsbedingungen\\\": \\\"string\\\",\\n  \\\"gesamtnettowert\\\": 0,\\n  \\\"positionen\\\": [\\n    {\\n      \\\"position_nr\\\": \\\"string\\\",\\n      \\\"zeilen_nr\\\": \\\"string\\\",\\n      \\\"bezeichnung\\\": \\\"string\\\",\\n      \\\"auftrag_nr\\\": \\\"string oder null\\\",\\n      \\\"projekt\\\": \\\"string oder null\\\",\\n      \\\"liefertermin\\\": \\\"DD.MM.YYYY oder null\\\",\\n      \\\"menge\\\": 0,\\n      \\\"einheit\\\": \\\"string\\\",\\n      \\\"einzelpreis\\\": 0,\\n      \\\"gesamtpreis\\\": 0\\n    }\\n  ]\\n}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "d6401856-94c4-4675-ba79-132fbabf1783",
      "name": "🤖 Claude - PDF auslesen",
