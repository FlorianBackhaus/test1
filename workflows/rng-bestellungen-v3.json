      "id": "ee1a0001-0001-0001-0001-000000000001",
      "name": "\ud83d\udcc4 PDF zu Base64",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [-64, 136]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $input.item;\nconst base64 = item.json.pdfBase64;\n\nif (!base64 || typeof base64 !== 'string') {\n  throw new Error('pdfBase64 fehlt oder ist kein String. Typ: ' + typeof base64);\n}\n\nconst prompt = 'Lies dieses PDF (RheinNetz Bestellung oder Bestelländerung) und extrahiere alle relevanten Daten.\\n\\nGib AUSSCHLIESSLICH ein JSON-Objekt zurück, kein Text davor oder danach, keine Markdown-Backticks.\\n\\nStruktur:\\n{\\n  \"dokumenttyp\": \"Bestellung\" oder \"Änderung zur Bestellung\",\\n  \"bestellnummer\": \"string\",\\n  \"bestelldatum\": \"DD.MM.YYYY\",\\n  \"tagesdatum\": \"DD.MM.YYYY\",\\n  \"kontrakt_nr\": \"string oder null\",\\n  \"ansprechpartner\": \"string\",\\n  \"ansprechpartner_tel\": \"string\",\\n  \"ansprechpartner_email\": \"string\",\\n  \"lieferantennr\": \"string\",\\n  \"anlieferadresse_name\": \"string oder null\",\\n  \"anlieferadresse_strasse\": \"string\",\\n  \"anlieferadresse_plz\": \"string\",\\n  \"anlieferadresse_ort\": \"string\",\\n  \"zahlungsbedingungen\": \"string\",\\n  \"gesamtnettowert\": 0,\\n  \"positionen\": [\\n    {\\n      \"position_nr\": \"string\",\\n      \"zeilen_nr\": \"string\",\\n      \"bezeichnung\": \"string\",\\n      \"auftrag_nr\": \"string oder null\",\\n      \"projekt\": \"string oder null\",\\n      \"liefertermin\": \"DD.MM.YYYY oder null\",\\n      \"menge\": 0,\\n      \"einheit\": \"string\",\\n      \"einzelpreis\": 0,\\n      \"gesamtpreis\": 0\\n    }\\n  ]\\n}';\n\nconst claudeBody = JSON.stringify({\n  model: 'claude-sonnet-4-5',\n  max_tokens: 2000,\n  messages: [{\n    role: 'user',\n    content: [\n      {\n        type: 'document',\n        source: {\n          type: 'base64',\n          media_type: 'application/pdf',\n          data: base64\n        }\n      },\n      {\n        type: 'text',\n        text: prompt\n      }\n    ]\n  }]\n});\n\nreturn [{ json: { claudeBody } }];"
      },
